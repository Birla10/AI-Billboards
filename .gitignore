# ============================
# 🔹 Global Ignore (Root)
# ============================

# Ignore system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Ignore IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*.swn

# ============================
# 🔹 Backend (Python)
# ============================
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class

# Virtual environment
backend/venv/
backend/env/
backend/*.env
backend/*.venv

# Distribution / packaging
backend/build/
backend/dist/
backend/*.egg-info/

# Logs and database files
backend/*.log
backend/*.sqlite3
backend/*.db
# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd


# Jupyter Notebook
backend/.ipynb_checkpoints/

frontend/node_modules/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Build files
frontend/build/
frontend/dist/

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Testing
frontend/coverage/
frontend/jest/
frontend/cypress/screenshots/
frontend/cypress/videos/
